    <span class="label">// Contact</span>
    <h2 class="h-section" style="margin-bottom:.75rem">
      Prêt à monter<br><span style="color:var(--red)">sur le ring.</span>
    </h2>
    <p style="font-size:.95rem;color:var(--muted);margin-bottom:2.5rem;line-height:1.7">
