<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Alexandre Palmer — Data × IA × Sport</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* ── TOKENS ─────────────────────────────── */
    :root {
      --navy:    #001f5b;
      --navy-lt: #0a3080;
      --red:     #E3000B;
      --bg:      #f4f5f7;
      --white:   #ffffff;
      --border:  rgba(0,0,0,.09);
      --text:    #111111;
      --muted:   #666666;
      --dim:     #999999;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; }
    html  { scroll-behavior: smooth; }
    body  {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ── TYPE ────────────────────────────────── */
    .f-disp { font-family: 'Bebas Neue', sans-serif; }
    .f-ui   { font-family: 'Rajdhani', sans-serif; font-weight: 700; }
    .f-mono { font-family: 'JetBrains Mono', monospace; }

    /* ── NAV ─────────────────────────────────── */
    .nav-item {
      font-family: 'Rajdhani', sans-serif; font-weight: 700;
      font-size: .72rem; letter-spacing: .14em; text-transform: uppercase;
      color: var(--muted); transition: color .2s; position: relative;
    }
    .nav-item::after {
      content: ''; position: absolute; bottom: -4px; left: 0; right: 0;
      height: 2px; background: var(--red); transform: scaleX(0); transition: transform .2s;
    }
    .nav-item:hover { color: var(--navy); }
    .nav-item:hover::after { transform: scaleX(1); }

    /* ── LABEL ───────────────────────────────── */
    .label {
      font-family: 'JetBrains Mono', monospace;
      font-size: .6rem; letter-spacing: .4em; text-transform: uppercase;
      color: var(--red); display: block; margin-bottom: .85rem;
    }

    /* ── HEADINGS ────────────────────────────── */
    .h-hero {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(5rem, 14vw, 11rem);
      line-height: .88; letter-spacing: -.01em; color: var(--navy);
    }
    .h-section {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3rem, 6vw, 5rem);
      line-height: .93; color: var(--navy);
    }

    /* ── BUTTONS ─────────────────────────────── */
    .btn-fill {
      display: inline-flex; align-items: center;
      font-family: 'Rajdhani', sans-serif; font-weight: 700;
      font-size: .78rem; letter-spacing: .16em; text-transform: uppercase;
      background: var(--navy); color: #fff;
      padding: .72rem 2rem; border-radius: 5px; border: none; cursor: pointer;
      transition: background .2s, transform .2s, box-shadow .2s;
    }
    .btn-fill:hover { background: var(--navy-lt); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,31,91,.25); }

    .btn-outline {
      display: inline-flex; align-items: center;
      font-family: 'Rajdhani', sans-serif; font-weight: 700;
      font-size: .78rem; letter-spacing: .16em; text-transform: uppercase;
      background: transparent; color: var(--navy);
      padding: .72rem 2rem; border-radius: 5px;
      border: 2px solid var(--navy); cursor: pointer;
      transition: background .2s, color .2s;
    }
    .btn-outline:hover { background: var(--navy); color: #fff; }

    /* ── CARD ────────────────────────────────── */
    .card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 14px;
      transition: box-shadow .25s, transform .25s;
    }
    .card:hover { box-shadow: 0 12px 40px rgba(0,31,91,.1); transform: translateY(-3px); }

    /* ── ID TAG ──────────────────────────────── */
    .id-tag {
      display: inline-flex;
      font-family: 'JetBrains Mono', monospace; font-size: .6rem;
      letter-spacing: .18em; text-transform: uppercase;
      color: var(--navy); background: rgba(0,31,91,.07);
      border: 1px solid rgba(0,31,91,.18); border-radius: 3px;
      padding: .18rem .55rem;
    }

    /* ── DOMAIN TAG ──────────────────────────── */
    .tag {
      display: inline-flex;
      font-family: 'Rajdhani', sans-serif; font-weight: 700;
      font-size: .64rem; letter-spacing: .1em; text-transform: uppercase;
      color: var(--muted); background: var(--bg);
      border: 1px solid var(--border); border-radius: 3px;
      padding: .15rem .5rem;
    }

    /* ── SKILL CARD ──────────────────────────── */
    .skill-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 2rem 1.75rem;
      transition: box-shadow .25s, transform .25s;
    }
    .skill-card:hover { box-shadow: 0 12px 40px rgba(0,31,91,.1); transform: translateY(-3px); }
    .skill-icon {
      width: 44px; height: 44px; border-radius: 10px;
      background: rgba(0,31,91,.08);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1rem;
    }

    /* ── ROUND BADGE ─────────────────────────── */
    .round-badge {
      font-family: 'Bebas Neue', sans-serif; font-size: .8rem;
      letter-spacing: .35em; text-transform: uppercase; color: var(--red);
      display: block; margin-bottom: .5rem;
    }

    /* ── BIG BG NUMBER ───────────────────────── */
    .bg-num {
      font-family: 'Bebas Neue', sans-serif; font-size: 7rem; line-height: 1;
      color: var(--navy); opacity: .05;
      position: absolute; top: .5rem; right: 1.25rem;
      user-select: none; pointer-events: none;
    }

    /* ── PROJECT CARD ────────────────────────── */
    .proj-card {
      background: var(--white); border: 1px solid var(--border); border-radius: 14px;
      overflow: hidden; display: flex; flex-direction: column;
      transition: box-shadow .25s, transform .25s;
    }
    .proj-card:hover { box-shadow: 0 12px 40px rgba(0,31,91,.1); transform: translateY(-3px); }
    .proj-bar {
      height: 3px;
      background: linear-gradient(90deg, var(--navy) 0%, var(--red) 100%);
    }

    /* ── LOOM BTN ────────────────────────────── */
    .loom-btn {
      display: inline-flex; align-items: center; gap: .4rem;
      font-family: 'Rajdhani', sans-serif; font-weight: 700;
      font-size: .68rem; letter-spacing: .12em; text-transform: uppercase;
      color: var(--navy); background: rgba(0,31,91,.06);
      border: 1px solid rgba(0,31,91,.22); border-radius: 4px;
      padding: .4rem .85rem; cursor: pointer;
      transition: background .2s, border-color .2s;
    }
    .loom-btn:hover { background: rgba(0,31,91,.12); border-color: rgba(0,31,91,.45); }

    /* ── PSG SECTION ─────────────────────────── */
    .psg-section { background: var(--navy); }
    .psg-card {
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 14px; overflow: hidden;
      transition: background .25s, transform .25s;
    }
    .psg-card:hover { background: rgba(255,255,255,.1); transform: translateY(-3px); }

    /* ── CONTACT ─────────────────────────────── */
    .field {
      display: block; width: 100%;
      background: var(--bg); border: 1.5px solid var(--border);
      border-radius: 6px; color: var(--text);
      font-size: .875rem; padding: .65rem .85rem; outline: none;
      transition: border-color .2s; font-family: 'Inter', sans-serif;
    }
    .field:focus { border-color: var(--navy); }
    .field-label {
      font-family: 'JetBrains Mono', monospace; font-size: .58rem;
      letter-spacing: .28em; text-transform: uppercase; color: var(--muted);
      display: block; margin-bottom: .4rem;
    }

    /* ── DIVIDER ─────────────────────────────── */
    .divider { height: 1px; background: var(--border); }

    /* ── HERO DECOR LINE ─────────────────────── */
    .red-line { width: 56px; height: 4px; background: var(--red); border-radius: 2px; }

    /* ── FADE UP ─────────────────────────────── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-up { animation: fadeUp .6s ease-out both; }
  </style>
</head>
<body>

<!-- ══════════════════════════════════════
     HEADER
══════════════════════════════════════ -->
<header style="position:sticky;top:0;z-index:50;background:rgba(255,255,255,.95);border-bottom:1px solid var(--border);backdrop-filter:blur(16px)">
  <div style="max-width:1120px;margin:0 auto;padding:0 1.25rem;display:flex;align-items:center;justify-content:space-between;height:60px">
    <a href="#hero" style="display:flex;align-items:center;gap:.75rem;text-decoration:none">
      <span class="f-disp" style="font-size:1.5rem;letter-spacing:.08em;color:var(--navy)">PALMER</span>
      <span class="f-mono" style="font-size:.58rem;letter-spacing:.3em;text-transform:uppercase;color:var(--red);opacity:.8">Data × IA × Sport</span>
    </a>
    <nav style="display:flex;align-items:center;gap:1.75rem">
      <a href="#hero"        class="nav-item" style="text-decoration:none">Accueil</a>
      <a href="#about"       class="nav-item" style="text-decoration:none">Parcours</a>
      <a href="#skills"      class="nav-item" style="text-decoration:none">Compétences</a>
      <a href="#projects"    class="nav-item" style="text-decoration:none">Projets</a>
      <a href="#psg-matches" class="nav-item" style="text-decoration:none">PSG</a>
      <a href="#contact"     class="nav-item" style="text-decoration:none">Contact</a>
    </nav>
  </div>
</header>


<!-- ══════════════════════════════════════
     HERO
══════════════════════════════════════ -->
<section id="hero" style="background:var(--white);padding:5rem 0 4rem">
  <div style="max-width:1120px;margin:0 auto;padding:0 1.25rem">

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center" class="fade-up">

      <!-- LEFT -->
      <div>
        <span class="label">// AI Applied to Business — Eugenia School</span>
        <h1 class="h-hero">
          ALEXANDRE<br>
          <span style="color:var(--red)">PALMER</span>
        </h1>
        <div class="red-line" style="margin:1.5rem 0"></div>
        <p style="font-size:1.05rem;line-height:1.75;color:var(--muted);max-width:420px">
          Je construis des solutions data &amp; IA pour des problèmes business concrets.
          Formé sur le terrain — stages, hackathons, Station&nbsp;F — avec la discipline du sport et l'ambition de toujours délivrer.
        </p>
        <div style="margin-top:1.5rem;display:flex;flex-wrap:wrap;gap:.5rem">
          <span class="id-tag">MMA</span>
          <span class="id-tag">PSG 2014</span>
          <span class="id-tag">Station F</span>
          <span class="id-tag">Eugenia School</span>
        </div>
        <div style="margin-top:2rem;display:flex;flex-wrap:wrap;gap:.75rem">
          <a href="#projects" class="btn-fill">Voir mes projets</a>
          <a href="#contact"  class="btn-outline">Parler collab</a>
        </div>
      </div>

      <!-- RIGHT: profile card -->
      <div class="card" style="padding:2rem;border-top:4px solid var(--navy)">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1.5rem">
          <div>
            <p class="f-mono" style="font-size:.58rem;color:var(--dim);letter-spacing:.28em;text-transform:uppercase">Profil</p>
            <p class="f-disp" style="font-size:2rem;letter-spacing:.06em;color:var(--navy);margin-top:.2rem">PALMER</p>
            <p class="f-mono" style="font-size:.58rem;color:var(--dim);letter-spacing:.2em;text-transform:uppercase;margin-top:.15rem">Paris, France</p>
          </div>
          <span class="id-tag" style="margin-top:.25rem">AI × Business × Sport</span>
        </div>

        <div class="divider" style="margin-bottom:1.5rem"></div>

        <!-- Skills as clean list, no scores -->
        <div style="display:flex;flex-direction:column;gap:1rem">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span class="f-ui" style="font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;color:var(--text)">Data &amp; IA</span>
            <span class="f-mono" style="font-size:.6rem;color:var(--dim);letter-spacing:.15em">Looker · Sheets · ChatGPT</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span class="f-ui" style="font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;color:var(--text)">Business &amp; Pitch</span>
            <span class="f-mono" style="font-size:.6rem;color:var(--dim);letter-spacing:.15em">Stratégie · Jury · Clients</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span class="f-ui" style="font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;color:var(--text)">No-code &amp; Automatisation</span>
            <span class="f-mono" style="font-size:.6rem;color:var(--dim);letter-spacing:.15em">Miro · Canva · Make</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span class="f-ui" style="font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;color:var(--text)">Discipline Sportive</span>
            <span class="f-mono" style="font-size:.6rem;color:var(--dim);letter-spacing:.15em">MMA · Muscu · PSG</span>
          </div>
        </div>

        <div class="divider" style="margin:1.5rem 0"></div>
        <p style="font-size:.82rem;color:var(--muted);font-style:italic;line-height:1.6">
          « Même exigence sur le terrain sportif et sur les projets data. »
        </p>
      </div>

    </div>
  </div>
</section>


<!-- ══════════════════════════════════════
     ABOUT — ROUNDS
══════════════════════════════════════ -->
<section id="about" style="padding:6rem 0">
  <div style="max-width:1120px;margin:0 auto;padding:0 1.25rem">
    <span class="label">// Parcours</span>
    <h2 class="h-section" style="margin-bottom:2.5rem">
      Construit sur le terrain.<br>
      <span style="color:var(--red)">Round par round.</span>
    </h2>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:1.25rem">

      <div class="card" style="padding:1.75rem;position:relative;overflow:hidden">
        <span class="bg-num">01</span>
        <span class="round-badge">Round 01 · 2022</span>
        <h3 class="f-ui" style="font-size:1.15rem;color:var(--navy);margin-bottom:.2rem">EquiData Sport</h3>
        <p class="f-mono" style="font-size:.58rem;color:var(--dim);letter-spacing:.2em;text-transform:uppercase;margin-bottom:1.1rem">Start-up · Stage de seconde</p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.65rem">
          <li style="display:flex;gap:.6rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red);flex-shrink:0;margin-top:.1rem">▸</span>Marketing digital &amp; data pour booster la visibilité</li>
          <li style="display:flex;gap:.6rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red);flex-shrink:0;margin-top:.1rem">▸</span>Analyse de signaux marché pour alimenter les campagnes</li>
        </ul>
      </div>

      <div class="card" style="padding:1.75rem;position:relative;overflow:hidden">
        <span class="bg-num">02</span>
        <span class="round-badge">Round 02 · 2025</span>
        <h3 class="f-ui" style="font-size:1.15rem;color:var(--navy);margin-bottom:.2rem">Go Fusion — Station F</h3>
        <p class="f-mono" style="font-size:.58rem;color:var(--dim);letter-spacing:.2em;text-transform:uppercase;margin-bottom:1.1rem">Start-up · Stage bachelor</p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.65rem">
          <li style="display:flex;gap:.6rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red);flex-shrink:0;margin-top:.1rem">▸</span>SEO, optimisation de contenu et reporting</li>
          <li style="display:flex;gap:.6rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red);flex-shrink:0;margin-top:.1rem">▸</span>Roadmap growth avec les fondateurs</li>
        </ul>
      </div>

      <div class="card" style="padding:1.75rem;position:relative;overflow:hidden">
        <span class="bg-num">03</span>
        <span class="round-badge">Round 03 · 2024–2025</span>
        <h3 class="f-ui" style="font-size:1.15rem;color:var(--navy);margin-bottom:.2rem">Hackathons &amp; BDD</h3>
        <p class="f-mono" style="font-size:.58rem;color:var(--dim);letter-spacing:.2em;text-transform:uppercase;margin-bottom:1.1rem">Eugenia School · Compétitions</p>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.65rem">
          <li style="display:flex;gap:.6rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red);flex-shrink:0;margin-top:.1rem">▸</span>Histia, Carrefour, Geniathon Malt</li>
          <li style="display:flex;gap:.6rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red);flex-shrink:0;margin-top:.1rem">▸</span>Dashboards Looker Studio &amp; pitch decks</li>
        </ul>
      </div>

    </div>
  </div>
</section>


<!-- ══════════════════════════════════════
     SKILLS
══════════════════════════════════════ -->
<section id="skills" style="padding:6rem 0;background:var(--white)">
  <div style="max-width:1120px;margin:0 auto;padding:0 1.25rem">
    <span class="label">// Compétences</span>
    <h2 class="h-section" style="margin-bottom:.75rem">Ce que je mets<br><span style="color:var(--red)">sur le terrain.</span></h2>
    <p style="font-size:.95rem;color:var(--muted);max-width:520px;line-height:1.7;margin-bottom:3rem">
      Chaque mission est abordée comme une préparation sportive : structure, répétition, impact mesurable.
    </p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.25rem">

      <div class="skill-card">
        <div class="skill-icon">
          <svg width="22" height="22" fill="none" stroke="var(--navy)" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
          </svg>
        </div>
        <h3 class="f-ui" style="font-size:1rem;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);margin-bottom:.75rem">Data &amp; IA</h3>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.5rem">
          <li style="display:flex;gap:.5rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red)">▸</span>Bases de données</li>
          <li style="display:flex;gap:.5rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red)">▸</span>Looker Studio</li>
          <li style="display:flex;gap:.5rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red)">▸</span>Workflows IA</li>
        </ul>
      </div>

      <div class="skill-card">
        <div class="skill-icon">
          <svg width="22" height="22" fill="none" stroke="var(--navy)" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
        </div>
        <h3 class="f-ui" style="font-size:1rem;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);margin-bottom:.75rem">Code &amp; No-code</h3>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.5rem">
          <li style="display:flex;gap:.5rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red)">▸</span>Automatisations IA</li>
          <li style="display:flex;gap:.5rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red)">▸</span>Google Sheets avancé</li>
        </ul>
      </div>

      <div class="skill-card">
        <div class="skill-icon">
          <svg width="22" height="22" fill="none" stroke="var(--navy)" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <h3 class="f-ui" style="font-size:1rem;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);margin-bottom:.75rem">Business</h3>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.5rem">
          <li style="display:flex;gap:.5rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red)">▸</span>Marketing &amp; finances</li>
          <li style="display:flex;gap:.5rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red)">▸</span>Modèles économiques</li>
        </ul>
      </div>

      <div class="skill-card">
        <div class="skill-icon">
          <svg width="22" height="22" fill="none" stroke="var(--navy)" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
        </div>
        <h3 class="f-ui" style="font-size:1rem;letter-spacing:.1em;text-transform:uppercase;color:var(--navy);margin-bottom:.75rem">Pitch &amp; Comm</h3>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:.5rem">
          <li style="display:flex;gap:.5rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red)">▸</span>Storytelling exécutif</li>
          <li style="display:flex;gap:.5rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red)">▸</span>Pitch jury &amp; clients</li>
          <li style="display:flex;gap:.5rem;font-size:.875rem;color:var(--muted)"><span style="color:var(--red)">▸</span>Design de présentations</li>
        </ul>
      </div>

    </div>
  </div>
</section>


<!-- ══════════════════════════════════════
     PROJECTS
══════════════════════════════════════ -->
<section id="projects" style="padding:6rem 0">
  <div style="max-width:1120px;margin:0 auto;padding:0 1.25rem">
    <span class="label">// Projets réalisés</span>
    <h2 class="h-section" style="margin-bottom:.75rem">Sur le <span style="color:var(--red)">ring.</span></h2>
    <p style="font-size:.95rem;color:var(--muted);max-width:480px;line-height:1.7;margin-bottom:3rem">
      Une sélection de réalisations qui mixent rigueur data et vision business.
    </p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.25rem">
      <% projects.forEach(function(project) { %>
      <article class="proj-card">
        <div class="proj-bar"></div>
        <div style="padding:1.5rem;flex:1;display:flex;flex-direction:column">

          <% if (project.logo) { %>
          <div style="height:68px;display:flex;align-items:center;justify-content:center;background:var(--bg);border-radius:8px;margin-bottom:1.25rem">
            <img src="<%= project.logo %>" alt="<%= project.title %>" style="max-height:40px;max-width:60%;object-fit:contain">
          </div>
          <% } %>

          <h3 class="f-ui" style="font-size:1.15rem;color:var(--navy);margin-bottom:.35rem"><%= project.title %></h3>

          <p class="f-mono" style="font-size:.58rem;color:var(--dim);letter-spacing:.18em;text-transform:uppercase;margin-bottom:.9rem">
            <%= project.date %><% if(project.tools){ %> · <%= project.tools %><% } %>
          </p>

          <p style="font-size:.875rem;color:var(--text);line-height:1.65;margin-bottom:.5rem"><%= project.description %></p>
          <p style="font-size:.82rem;color:var(--muted);line-height:1.65;margin-bottom:1rem"><%= project.summary %></p>

          <% if (project.loomEmbedId) {
            var ar = project.loomAspectRatio || 56.25;
            var st = String(project.title||'').replace(/'/g,"\\'").replace(/"/g,'\\"');
          %>
          <div style="margin-bottom:1rem">
            <button type="button" class="loom-btn" onclick="openLoom('<%= project.loomEmbedId %>','<%= ar %>','<%= st %>')">
              <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Voir la vidéo
            </button>
          </div>
          <% } %>

          <div style="display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:1rem">
            <% project.domains.forEach(function(d){ %><span class="tag"><%= d %></span><% }) %>
          </div>

          <details style="margin-top:auto">
            <summary style="cursor:pointer;font-family:'Rajdhani',sans-serif;font-weight:700;font-size:.68rem;letter-spacing:.15em;text-transform:uppercase;color:var(--navy);list-style:none;user-select:none">
              Approche &amp; résultats ▾
            </summary>
            <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:.85rem;font-size:.82rem;color:var(--muted)">
              <p><strong style="color:var(--text)">Intro :</strong> <%= project.sections.intro %></p>
              <div>
                <p class="f-ui" style="font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--navy);margin-bottom:.5rem">Approche</p>
                <ul style="list-style:none;display:flex;flex-direction:column;gap:.4rem">
                  <% project.sections.approach.forEach(function(s){ %>
                  <li style="display:flex;gap:.5rem"><span style="color:var(--navy);flex-shrink:0">▸</span><%= s %></li>
                  <% }) %>
                </ul>
              </div>
              <div>
                <p class="f-ui" style="font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--navy);margin-bottom:.5rem">Résultats</p>
                <ul style="list-style:none;display:flex;flex-direction:column;gap:.4rem">
                  <% project.sections.results.forEach(function(r){ %>
                  <li style="display:flex;gap:.5rem"><span style="color:#16a34a;flex-shrink:0">▸</span><%= r %></li>
                  <% }) %>
                </ul>
              </div>
            </div>
          </details>

        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>


<!-- ══════════════════════════════════════
     PSG MATCHES — fond marine
══════════════════════════════════════ -->
<section id="psg-matches" class="psg-section" style="padding:6rem 0">
  <div style="max-width:1120px;margin:0 auto;padding:0 1.25rem">

    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:3rem">
      <div>
        <span class="label" style="color:rgba(255,255,255,.4)">// PSG — Live Schedule</span>
        <h2 class="h-section" style="color:#fff">
          Prochains matchs du<br>
          <span style="color:var(--red)">Paris S-G.</span>
        </h2>
      </div>
      <span class="f-mono" style="font-size:.55rem;color:rgba(255,255,255,.2);letter-spacing:.25em;text-transform:uppercase">
        source: api.football-data.org
      </span>
    </div>

    <% if (psgMatches && psgMatches.length) { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem">
      <% psgMatches.forEach(function(match) {
        const d = new Date(match.utcDate);
        const dateStr = d.toLocaleDateString("fr-FR",{weekday:"long",day:"numeric",month:"long",year:"numeric",timeZone:"Europe/Paris"});
        const timeStr = d.toLocaleTimeString("fr-FR",{hour:"2-digit",minute:"2-digit",timeZone:"Europe/Paris"});
        const dayStr  = d.toLocaleDateString("fr-FR",{weekday:"short",timeZone:"Europe/Paris"});
        const isHome  = match.homeTeam.name.toLowerCase().includes('paris')||match.homeTeam.name.toLowerCase().includes('psg');
        const opp     = isHome ? match.awayTeam.name : match.homeTeam.name;
      %>
      <article class="psg-card" style="padding:1.5rem">

        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
          <span class="f-mono" style="font-size:.55rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.4);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:3px;padding:.15rem .5rem">
            <%= match.competition&&match.competition.name ? match.competition.name : "Compétition" %>
          </span>
          <span class="f-ui" style="font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:<%= isHome ? '#E3000B' : 'rgba(255,255,255,.4)' %>">
            <%= isHome ? 'DOMICILE' : 'EXTÉRIEUR' %>
          </span>
        </div>

        <p class="f-mono" style="font-size:.55rem;color:rgba(255,255,255,.3);letter-spacing:.18em;text-transform:uppercase;margin-bottom:.25rem"><%= dayStr %></p>
        <p style="font-size:.85rem;color:rgba(255,255,255,.65);margin-bottom:.2rem"><%= dateStr %></p>
        <p class="f-disp" style="font-size:2.4rem;color:#fff;line-height:1;margin-bottom:1.25rem"><%= timeStr %></p>

        <div style="display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.85rem 0;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:<% if(match.venue){%>1rem<%}else{%>0<%}%>">
          <p class="f-ui" style="font-size:.95rem;color:#fff;flex:1;text-align:right;line-height:1.2"><%= isHome ? 'PSG' : opp %></p>
          <div style="width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <span class="f-disp" style="font-size:.7rem;color:rgba(255,255,255,.7)">VS</span>
          </div>
          <p class="f-ui" style="font-size:.95rem;color:#fff;flex:1;text-align:left;line-height:1.2"><%= isHome ? opp : 'PSG' %></p>
        </div>

        <% if (match.venue) { %>
        <div style="display:flex;align-items:center;gap:.4rem">
          <svg width="11" height="11" fill="none" stroke="rgba(255,255,255,.3)" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span class="f-mono" style="font-size:.58rem;color:rgba(255,255,255,.3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= match.venue %></span>
        </div>
        <% } %>

      </article>
      <% }) %>
    </div>
    <% } else { %>
    <div style="text-align:center;padding:3rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:12px">
      <p class="f-mono" style="font-size:.75rem;color:rgba(255,255,255,.25)">// Données non disponibles pour le moment.</p>
    </div>
    <% } %>

  </div>
</section>


<!-- ══════════════════════════════════════
     CONTACT
══════════════════════════════════════ -->
<section id="contact" style="padding:6rem 0;background:var(--white)">
