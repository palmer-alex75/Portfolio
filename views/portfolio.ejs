      <div style="margin-top:1.75rem;padding-top:1.5rem;border-top:1px solid var(--border);display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center">
        <a href="tel:0664290311" style="display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;background:var(--bg);border:1px solid var(--border);border-radius:5px;text-decoration:none;transition:border-color .2s" onmouseover="this.style.borderColor='var(--navy)'" onmouseout="this.style.borderColor='var(--border)'">
          <img src="/images/logo_téléphone.jpg" alt="Téléphone" style="width:17px;height:17px;object-fit:contain">
          <span class="f-ui" style="font-size:.82rem;color:var(--muted)">06 64 29 03 11</span>
        </a>
        <a href="mailto:alexandrepalmer06@gmail.com" style="display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;background:var(--bg);border:1px solid var(--border);border-radius:5px;text-decoration:none;transition:border-color .2s" onmouseover="this.style.borderColor='var(--navy)'" onmouseout="this.style.borderColor='var(--border)'">
          <img src="/images/logo_email.jpg" alt="Email" style="width:17px;height:17px;object-fit:contain">
          <span class="f-ui" style="font-size:.82rem;color:var(--muted)">alexandrepalmer06@gmail.com</span>
        </a>
        <a href="https://www.linkedin.com/in/alexandre-palmer/" target="_blank" rel="noreferrer" style="display:inline-flex;align-items:center;gap:.55rem;padding:.5rem .85rem;background:var(--bg);border:1px solid var(--border);border-radius:5px;text-decoration:none;transition:border-color .2s" onmouseover="this.style.borderColor='var(--navy)'" onmouseout="this.style.borderColor='var(--border)'">
          <img src="/images/logo_linkedin.png" alt="LinkedIn" style="width:17px;height:17px;object-fit:contain">
          <span class="f-ui" style="font-size:.82rem;color:var(--muted)">alexandre-palmer</span>
